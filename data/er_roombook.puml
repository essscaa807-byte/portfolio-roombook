@startuml RoomBook-ER
title RoomBook — логическая модель данных (Crow's Foot)

hide circle
skinparam linetype ortho

entity "User" as user {
  * id : uuid <<PK>>
  --
  * email : varchar(255) <<UQ>>
  * password_hash : varchar(255)
  * role : user_role
  * created_at : timestamptz
  --
  * CHECK (email LIKE '%@%')
}

entity "Room" as room {
  * id : uuid <<PK>>
  --
  * name : varchar(120)
  * capacity : smallint
  * equipment : text[]
  * is_active : boolean
  * created_at : timestamptz
  --
  * CHECK (capacity >= 1)
  * INDEX (is_active, capacity)
}

entity "Booking" as booking {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * room_id : uuid <<FK>>
  * start_time : timestamptz
  * end_time : timestamptz
  * status : booking_status
  * idempotency_key : uuid <<UQ>>
  * created_at : timestamptz
  * cancelled_at : timestamptz
  --
  * CHECK (end_time > start_time)
  * CHECK (extract(minute from start_time) % 30 = 0)
  * INDEX (room_id, start_time, end_time)
  * INDEX (user_id, status)
}

package "Ограничения целостности" {
  note top of booking
    BK-1: нет двух CONFIRMED-броней
    с пересечением по одной комнате
    (EXCLUSION CONSTRAINT / транзакция)

    BK-2: отмена EMPLOYEE невозможна
    позже чем за 1 час до start_time
    (проверка в BookingService)
  end note
}

user ||--o{ booking : "создаёт (1:N)"
room ||--o{ booking : "принимает (1:N)"

@enduml
